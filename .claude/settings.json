{
  "permissions": {
    "allow": [
      "Read", "Write",
      "Bash(git *)", "Bash(python *)", "Bash(node *)",
      "Bash(npm *)", "Bash(ruff *)", "Bash(pytest *)"
    ],
    "deny": [
      "Read(.env)", "Read(.env.*)",
      "Write(.env)", "Write(.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read f; case \"$f\" in *.py) ruff format \"$f\" 2>/dev/null; ruff check --fix \"$f\" 2>/dev/null;; esac; true; }"
          }
        ]
      }
    ]
  }
}
